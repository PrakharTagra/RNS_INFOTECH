# ============================================================
# frontend (customer storefront) — Vercel environment variables
# ============================================================
# Project Settings → Environment Variables → add for "Production"
# (and "Preview" too if you want preview deploys to hit the real API).
#
# Fill in your actual Render service URL once it's deployed and you
# know its onrender.com address (or your own custom API domain).
VITE_API_BASE_URL=https://your-storefront-backend.onrender.com/api
