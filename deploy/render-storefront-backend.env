# ============================================================
# storefront-backend — Render environment variables (reference)
# ============================================================
# Do NOT commit this file with real secrets filled in.
# Paste these into Render → your storefront-backend service → Environment.
# Render sets PORT itself — do not set PORT manually.

APP_ENV=production
NODE_ENV=production

# Mongo Atlas connection string (production cluster / database name)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rns_storefront_prod?retryWrites=true&w=majority

# Comma-separated, NO trailing slashes. Your Vercel storefront production
# domain, plus any custom domain once you attach one.
CORS_ORIGIN=https://your-storefront.vercel.app

# Generate independent, long random strings for each — e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must differ from admin-backend's JWT_ADMIN_SECRET.
JWT_ACCESS_SECRET=<generate-a-long-random-string>
JWT_REFRESH_SECRET=<generate-a-different-long-random-string>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# MUST be false in production — the server refuses to boot otherwise.
OTP_DEBUG_ECHO=false

# Real SMTP provider (Brevo, SES, Postmark, Gmail SMTP with an app
# password, etc.) — customers need real OTP emails in production.
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
EMAIL_FROM=orders@yourdomain.com

# Razorpay LIVE mode keys (Settings > API Keys, switch out of Test Mode)
RAZORPAY_KEY_ID=<your-live-key-id>
RAZORPAY_KEY_SECRET=<your-live-key-secret>
# From Razorpay Dashboard > Webhooks, after you add the webhook URL below
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# Optional tuning — defaults shown, override only if needed
# RETURN_WINDOW_DAYS=7
# PAYMENT_RECONCILE_SECONDS=120
# GENERAL_RATE_LIMIT=180
# AUTH_RATE_LIMIT=20
# OTP_RATE_LIMIT=5
# PAYMENT_RATE_LIMIT=30
# PAYMENT_TIMEOUT_MINUTES=15

# Optional — where newsletter/demo/contact/quote form notifications get
# emailed (see POST /api/leads). Falls back to EMAIL_FROM if unset, so
# this is safe to leave blank, but you'll probably want your own inbox here.
LEAD_NOTIFY_EMAIL=orders@yourdomain.com
