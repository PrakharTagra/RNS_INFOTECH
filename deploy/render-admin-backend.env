# ============================================================
# admin-backend — Render environment variables (reference)
# ============================================================
# Do NOT commit this file with real secrets filled in.
# Paste these into Render → your admin-backend service → Environment.
# Render sets PORT itself — do not set PORT manually.

APP_ENV=production
NODE_ENV=production

# Can be the SAME Atlas cluster as storefront-backend, same database name
# (rns_storefront_prod) — the two services share Order/Product/Category
# collections by design.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rns_storefront_prod?retryWrites=true&w=majority

# Your Vercel admin-portal production domain
CORS_ORIGIN=https://your-admin-portal.vercel.app

# Long random string, different from storefront-backend's JWT secrets
JWT_ADMIN_SECRET=<generate-a-long-random-string>
JWT_ADMIN_TTL=15m
JWT_ADMIN_REFRESH_TTL=7d

ADMIN_REFRESH_COOKIE_NAME=rns_admin_refresh
# IMPORTANT: admin-portal (vercel.app) and admin-backend (onrender.com) are
# different domains, so this refresh cookie is cross-site. It MUST be
# SameSite=None + Secure=true in production, or the browser will silently
# drop the cookie and "stay logged in" / refresh-token rotation will break.
ADMIN_REFRESH_COOKIE_SAME_SITE=none
ADMIN_REFRESH_COOKIE_SECURE=true

ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCKOUT_MINUTES=15

ADMIN_PASSWORD_RESET_TTL_MINUTES=30
ADMIN_PASSWORD_RESET_URL=https://your-admin-portal.vercel.app/reset-password

SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
EMAIL_FROM=admin@yourdomain.com

ADMIN_INVITATION_URL=https://your-admin-portal.vercel.app/accept-invitation

# Cloudinary (product image uploads) — free tier is fine to start
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Same Razorpay LIVE keys as storefront-backend (used for refunds)
RAZORPAY_KEY_ID=<your-live-key-id>
RAZORPAY_KEY_SECRET=<your-live-key-secret>
