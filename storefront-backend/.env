NODE_ENV=development
SERVICE_NAME=storefront-backend
PORT=4000

# MongoDB — both services point at the SAME database name (shared data
# layer between the two independent services — see BACKEND_PLAN.md's
# ownership matrix), just via their own connection string.
MONGO_URI=mongodb://127.0.0.1:27017/rns_shared

# Storefront app origin — restrict CORS to just this in production.
CORS_ORIGIN=http://localhost:5173

# Auth secrets (Phase B1) — generate real random values before deploying,
# e.g. `openssl rand -hex 32`. These committed defaults are dev-only.
JWT_ACCESS_SECRET=dev-storefront-access-secret-change-me
JWT_REFRESH_SECRET=dev-storefront-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email-OTP tuning (Phase B1) — dev-safe defaults, tighten for production.
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_LIMIT=5
# Dev-only: echoes the generated OTP in /auth/request-otp's response so the
# flow is testable with no real email provider wired up. Ignored outright
# when NODE_ENV=production, but set to "false" here too once a real email
# provider is in place.
OTP_DEBUG_ECHO=true

# Razorpay (Phase B4) — test-mode keys from the Razorpay dashboard. Leave
# blank in local dev if you're not testing payments yet; every other route
# works fine without them. RAZORPAY_WEBHOOK_SECRET is configured
# separately from the key secret, in the dashboard's Webhooks section when
# you register the webhook URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP / Nodemailer (Phase A) — real OTP email delivery. Leave SMTP_HOST
# blank in local dev to keep using the console-log stand-in (see
# email.service.js). Works with any SMTP provider — Gmail SMTP, Brevo,
# Mailtrap, Postmark's SMTP mode, a company mail server, etc. EMAIL_FROM
# should be an address your chosen provider is authorized to send as.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RNS INFOTECH <no-reply@rnsinfotech.com>