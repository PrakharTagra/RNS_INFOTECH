NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/rns_shared
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEBUG_ECHO=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_FROM=RNS INFOTECH <noreply@example.com>
