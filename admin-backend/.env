NODE_ENV=development
PORT=4100

# MongoDB — same database name as storefront-backend's .env.example
# (shared data layer between the two independent services — see
# BACKEND_PLAN.md's ownership matrix), just via its own connection string.
MONGO_URI=mongodb://127.0.0.1:27017/rns_shared

# Admin portal app origin — restrict CORS to just this in production.
CORS_ORIGIN=http://localhost:5174

# Auth secret (Phase B1) — generate a real random value before deploying,
# e.g. `openssl rand -hex 32`. Deliberately a different secret from the
# storefront's, and never shared between the two services.
JWT_ADMIN_SECRET=dev-admin-secret-change-me
JWT_ADMIN_TTL=8h
JWT_ADMIN_REFRESH_TTL=30d

# Cloudinary (Phase B2) — product/category image uploads. Get these from
# the Cloudinary dashboard. Leave blank in local dev if you're not testing
# image upload yet; every other B2 route works fine without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Refresh-token cookie (Phase 16+) — local dev over plain HTTP, so Secure
# must stay false; SameSite=lax works fine for same-origin-ish local ports.
ADMIN_REFRESH_COOKIE_NAME=admin_refresh_token
ADMIN_REFRESH_COOKIE_SAME_SITE=lax
ADMIN_REFRESH_COOKIE_SECURE=false

# Admin login lockout (Phase 16+) — dev-safe defaults.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCKOUT_MINUTES=15

# Password reset (Phase 16+) — URL is the admin-portal's reset page.
ADMIN_PASSWORD_RESET_TTL_MINUTES=30
ADMIN_PASSWORD_RESET_URL=http://localhost:5174/reset-password

# Email (Phase 16+) — SMTP_HOST left blank, same console-log stand-in as
# storefront-backend uses in dev.
SMTP_PORT=587
EMAIL_FROM=RNS INFOTECH Admin <no-reply@rnsinfotech.com>
